{
  "id": "scout.kb.pretrip_view_summary",
  "version": "0.1.0",
  "description": "Summarize a local pretrip admin view or project root for Pydantic AI without mutating review/package state.",
  "command": {
    "argv": [
      "{python}",
      "-m",
      "scout_agent_builtin_tools",
      "kb-pretrip-view-summary",
      "--input",
      "{input}",
      "--json"
    ],
    "dry_run_argument": null
  },
  "mode": "local_evidence_query",
  "input_schema_ref": "schemas/scout_agent/kb_pretrip_view_summary.request.json",
  "output_schema_ref": "schemas/scout_agent/tool_result.json",
  "allowed_reads": [
    "pretrip.admin_view",
    "pretrip.project_root",
    "pretrip.review_queue"
  ],
  "allowed_writes": [],
  "forbidden_writes": [
    "phase1.runtime",
    "phase2.brain.observed_facts",
    "live.safety_api"
  ],
  "requires_authorization": {
    "kind": "none"
  },
  "trace": {
    "required": true,
    "event_kind": "agent_tool_invocation"
  }
}
