{
  "id": "scout.pretrip.route_architecture_collect",
  "version": "0.1.0",
  "description": "Collect Route Architecture Intelligence into the Scout pretrip workspace layout.",
  "command": {
    "argv": [
      "{python}",
      "-m",
      "scout_agent_builtin_tools",
      "pretrip-route-architecture-collect",
      "--input",
      "{input}",
      "--json"
    ],
    "dry_run_argument": "--dry-run"
  },
  "mode": "workspace_write",
  "input_schema_ref": "schemas/scout_agent/pretrip_route_architecture_collect.request.json",
  "output_schema_ref": "schemas/scout_agent/tool_result.json",
  "allowed_reads": [
    "pretrip.workspace.project",
    "pretrip.workspace.route_summary",
    "pretrip.workspace.checkpoint_candidates",
    "pretrip.workspace.segment_candidates",
    "pretrip.workspace.segment_policy_candidates",
    "pretrip.workspace.retreat_routes",
    "pretrip.workspace.planned_eta",
    "pretrip.workspace.risk_ribbon_metadata"
  ],
  "allowed_writes": [
    "pretrip.workspace.normalized.architecture.route_architecture"
  ],
  "forbidden_writes": [
    "phase1.runtime",
    "phase2.brain.observed_facts",
    "live.safety_api"
  ],
  "requires_authorization": {
    "kind": "user_or_operator"
  },
  "trace": {
    "required": true,
    "event_kind": "agent_tool_invocation"
  },
  "metadata": {
    "standard_alignment": "SCOUT_OUTDOOR_AI_AGENT_STANDARD Sec. 9 Route Architecture Intelligence",
    "workspace_layout_section": "Outdoor AI Agent Data Placement",
    "network_policy": "no_live_network_fetch",
    "candidate_only": true,
    "runtime_safety_truth": false
  }
}
