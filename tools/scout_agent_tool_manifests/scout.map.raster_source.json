{
  "id": "scout.map.raster_source",
  "version": "0.1.0",
  "description": "Inspect a local GeoTIFF and return a small Scout raster source manifest without copying raw raster data.",
  "command": {
    "argv": [
      "{python}",
      "-m",
      "scout_agent_builtin_tools",
      "map-raster-source",
      "--input",
      "{input}",
      "--json"
    ],
    "dry_run_argument": null
  },
  "mode": "local_evidence_query",
  "input_schema_ref": "schemas/scout_agent/map_raster_source.request.json",
  "output_schema_ref": "schemas/scout_agent/tool_result.json",
  "allowed_reads": [
    "local.geotiff.metadata",
    "local.raster_source_file"
  ],
  "allowed_writes": [],
  "forbidden_writes": [
    "phase1.runtime",
    "phase2.brain.observed_facts",
    "live.safety_api",
    "repo.raw_raster_fixture",
    "local.raster_tile_cache"
  ],
  "requires_authorization": {
    "kind": "none"
  },
  "trace": {
    "required": true,
    "event_kind": "agent_tool_invocation"
  },
  "metadata": {
    "read_only": true,
    "external_network_required": false,
    "raw_raster_committed_to_repo_allowed": false
  }
}
