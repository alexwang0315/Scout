{
  "id": "scout.pretrip.review_append_decisions",
  "version": "0.1.0",
  "description": "Append one or more reviewed pretrip candidate decisions to the local review decision log without mutating source artifacts, packages, runtime state, or MissionGraph outputs.",
  "command": {
    "argv": [
      "{python}",
      "-m",
      "scout_agent_builtin_tools",
      "pretrip-review-append-decisions",
      "--input",
      "{input}",
      "--json"
    ],
    "dry_run_argument": "--dry-run"
  },
  "mode": "workspace_write",
  "input_schema_ref": "schemas/scout_agent/pretrip_review_append_decisions.request.json",
  "output_schema_ref": "schemas/scout_agent/tool_result.json",
  "allowed_reads": [
    "pretrip.workspace.project",
    "pretrip.review_decision_log",
    "pretrip.review_queue_manifest"
  ],
  "allowed_writes": [
    "pretrip.review_decision_log"
  ],
  "forbidden_writes": [
    "pretrip.source_artifacts",
    "pretrip.package",
    "pretrip.mission_graph",
    "phase1.runtime",
    "phase2.brain.observed_facts",
    "live.safety_api",
    "runtime.session"
  ],
  "supports_dry_run": true,
  "requires_authorization": {
    "kind": "user_or_operator"
  },
  "trace": {
    "required": true,
    "event_kind": "agent_tool_invocation"
  },
  "metadata": {
    "append_only": true,
    "source_mutation_allowed": false,
    "package_mutation_allowed": false,
    "runtime_mutation_allowed": false,
    "phase1_runtime_mutation_allowed": false,
    "phase2_writeback_allowed": false,
    "compiles_mission_graph": false,
    "raw_payloads_embedded": false
  }
}
