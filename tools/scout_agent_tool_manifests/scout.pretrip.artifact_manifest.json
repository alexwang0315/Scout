{
  "id": "scout.pretrip.artifact_manifest",
  "version": "0.1.0",
  "description": "Build the pretrip artifact manifest from a local project.json as read-only provenance evidence.",
  "command": {
    "argv": [
      "{python}",
      "-m",
      "scout_agent_builtin_tools",
      "pretrip-artifact-manifest",
      "--input",
      "{input}",
      "--json"
    ],
    "dry_run_argument": null
  },
  "mode": "local_evidence_query",
  "input_schema_ref": "schemas/scout_agent/pretrip_artifact_manifest.request.json",
  "output_schema_ref": "schemas/scout_agent/tool_result.json",
  "allowed_reads": [
    "pretrip.workspace.project",
    "pretrip.workspace.outputs",
    "pretrip.workspace.sources"
  ],
  "allowed_writes": [],
  "forbidden_writes": [
    "phase1.runtime",
    "phase2.brain.observed_facts",
    "live.safety_api",
    "pretrip.workspace"
  ],
  "requires_authorization": {
    "kind": "none"
  },
  "trace": {
    "required": true,
    "event_kind": "agent_tool_invocation"
  },
  "metadata": {
    "read_only": true,
    "runtime_activation_allowed": false
  }
}
