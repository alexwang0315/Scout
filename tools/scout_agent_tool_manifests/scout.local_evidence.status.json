{
  "id": "scout.local_evidence.status",
  "version": "0.1.0",
  "description": "Return an offline Scout local evidence status summary for the current trip context.",
  "command": {
    "argv": [
      "{python}",
      "-m",
      "scout_agent_builtin_tools",
      "local-evidence-status",
      "--input",
      "{input}",
      "--json"
    ],
    "dry_run_argument": null
  },
  "mode": "local_evidence_query",
  "input_schema_ref": "schemas/scout_agent/local_evidence_status.request.json",
  "output_schema_ref": "schemas/scout_agent/tool_result.json",
  "allowed_reads": [
    "trip.local_evidence_index",
    "pretrip.admin_view",
    "hardware.readiness_summary",
    "runtime.debug_trace"
  ],
  "allowed_writes": [],
  "forbidden_writes": [
    "phase1.runtime",
    "live.safety_api"
  ],
  "requires_authorization": {
    "kind": "none"
  },
  "trace": {
    "required": true,
    "event_kind": "agent_tool_invocation"
  }
}
