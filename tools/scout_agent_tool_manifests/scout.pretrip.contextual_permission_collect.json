{
  "id": "scout.pretrip.contextual_permission_collect",
  "version": "0.1.0",
  "description": "Collect Contextual Permissioning candidate rules into the Scout pretrip workspace layout.",
  "command": {
    "argv": [
      "{python}",
      "-m",
      "scout_agent_builtin_tools",
      "pretrip-contextual-permission-collect",
      "--input",
      "{input}",
      "--json"
    ],
    "dry_run_argument": "--dry-run"
  },
  "mode": "workspace_write",
  "input_schema_ref": "schemas/scout_agent/pretrip_contextual_permission_collect.request.json",
  "output_schema_ref": "schemas/scout_agent/tool_result.json",
  "allowed_reads": [
    "pretrip.workspace.project",
    "pretrip.workspace.outputs.planned_eta",
    "pretrip.workspace.weather_daylight_evidence",
    "pretrip.workspace.outputs.plan_validation_candidates",
    "pretrip.workspace.outputs.energy_vitals",
    "pretrip.workspace.outputs.team_status",
    "pretrip.workspace.candidates.route_context_points",
    "pretrip.workspace.candidates.weather_decision_candidates"
  ],
  "allowed_writes": [
    "pretrip.workspace.normalized.permissions.contextual_permission_model",
    "pretrip.workspace.candidates.contextual_permission_rules"
  ],
  "forbidden_writes": [
    "phase1.runtime",
    "phase2.brain.observed_facts",
    "live.safety_api"
  ],
  "requires_authorization": {
    "kind": "user_or_operator"
  },
  "trace": {
    "required": true,
    "event_kind": "agent_tool_invocation"
  },
  "metadata": {
    "standard_alignment": "SCOUT_OUTDOOR_AI_AGENT_STANDARD Sec. 8 Contextual Permissioning",
    "workspace_layout_section": "Outdoor AI Agent Data Placement",
    "network_policy": "no_live_network_fetch",
    "candidate_only": true,
    "runtime_safety_truth": false
  }
}
