{
  "id": "scout.runtime.load_dry_run",
  "version": "0.1.0",
  "description": "Run the Phase 1 runtime loader dry-run checks against an export bundle without creating a live session.",
  "command": {
    "argv": [
      "{python}",
      "-m",
      "scout_agent_builtin_tools",
      "runtime-load-dry-run",
      "--input",
      "{input}",
      "--json"
    ],
    "dry_run_argument": null
  },
  "mode": "decision_support",
  "input_schema_ref": "schemas/scout_agent/runtime_load_dry_run.request.json",
  "output_schema_ref": "schemas/scout_agent/tool_result.json",
  "allowed_reads": [
    "runtime.export_bundle"
  ],
  "allowed_writes": [],
  "forbidden_writes": [
    "phase1.runtime",
    "phase2.brain.observed_facts",
    "live.safety_api"
  ],
  "requires_authorization": {
    "kind": "none"
  },
  "trace": {
    "required": true,
    "event_kind": "agent_tool_invocation"
  }
}
