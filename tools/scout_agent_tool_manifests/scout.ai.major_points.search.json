{
  "id": "scout.ai.major_points.search",
  "version": "0.1.0",
  "description": "Search MCP candidates, named points, OCR labels, and CP support reconciliation for named-place and major-point questions.",
  "command": {
    "argv": [
      "{python}",
      "-m",
      "scout_agent_builtin_tools",
      "ai-major-points",
      "--input",
      "{input}",
      "--json"
    ],
    "dry_run_argument": null
  },
  "mode": "local_evidence_query",
  "input_schema_ref": "schemas/scout_agent/ai_major_points.request.json",
  "output_schema_ref": "schemas/scout_agent/tool_result.json",
  "allowed_reads": [
    "pretrip.workspace.project",
    "pretrip.workspace.mcp_candidates",
    "pretrip.workspace.named_point_evidence",
    "pretrip.workspace.ocr_labels",
    "pretrip.workspace.cp_support_reconciliation"
  ],
  "allowed_writes": [],
  "forbidden_writes": [
    "phase1.runtime",
    "phase2.brain.observed_facts",
    "live.safety_api",
    "pretrip.workspace"
  ],
  "requires_authorization": {
    "kind": "none"
  },
  "trace": {
    "required": true,
    "event_kind": "agent_tool_invocation"
  },
  "metadata": {
    "read_only": true,
    "runtime_safety_truth": false,
    "runtime_activation_allowed": false
  }
}
