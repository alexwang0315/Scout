{
  "id": "scout.pretrip.readiness",
  "version": "0.1.0",
  "description": "Evaluate pretrip readiness rules as decision support without mutating hard readiness state.",
  "command": {
    "argv": [
      "{python}",
      "-m",
      "scout_agent_builtin_tools",
      "pretrip-readiness",
      "--input",
      "{input}",
      "--json"
    ],
    "dry_run_argument": null
  },
  "mode": "decision_support",
  "input_schema_ref": "schemas/scout_agent/pretrip_readiness.request.json",
  "output_schema_ref": "schemas/scout_agent/tool_result.json",
  "allowed_reads": [
    "pretrip.route_plan",
    "pretrip.skill_config_manifest"
  ],
  "allowed_writes": [],
  "forbidden_writes": [
    "phase1.runtime",
    "phase2.brain.observed_facts",
    "live.safety_api",
    "pretrip.workspace.readiness_report"
  ],
  "requires_authorization": {
    "kind": "none"
  },
  "trace": {
    "required": true,
    "event_kind": "agent_tool_invocation"
  },
  "metadata": {
    "decision_support_only": true,
    "hard_readiness_mutation_allowed": false
  }
}
