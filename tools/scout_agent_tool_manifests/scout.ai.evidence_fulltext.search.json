{
  "id": "scout.ai.evidence_fulltext.search",
  "version": "0.1.0",
  "description": "Run read-only full-text search over Scout's local evidence index across route notes, reports, reviews, MCP, OCR, and planning snippets.",
  "command": {
    "argv": [
      "{python}",
      "-m",
      "scout_agent_builtin_tools",
      "ai-evidence-fulltext",
      "--input",
      "{input}",
      "--json"
    ],
    "dry_run_argument": null
  },
  "mode": "local_evidence_query",
  "input_schema_ref": "schemas/scout_agent/ai_evidence_fulltext.request.json",
  "output_schema_ref": "schemas/scout_agent/tool_result.json",
  "allowed_reads": [
    "trip.local_evidence_index",
    "pretrip.workspace.project",
    "pretrip.workspace.candidates",
    "pretrip.workspace.reviews",
    "pretrip.workspace.outputs"
  ],
  "allowed_writes": [],
  "forbidden_writes": [
    "phase1.runtime",
    "phase2.brain.observed_facts",
    "live.safety_api",
    "pretrip.workspace"
  ],
  "requires_authorization": {
    "kind": "none"
  },
  "trace": {
    "required": true,
    "event_kind": "agent_tool_invocation"
  },
  "metadata": {
    "read_only": true,
    "runtime_safety_truth": false,
    "runtime_activation_allowed": false,
    "raw_payloads_embedded": false
  }
}
