{
  "id": "scout.map.raster_tiles",
  "version": "0.1.0",
  "description": "Build a local raster tile pyramid plan and optionally seed PNG tiles into an external local cache.",
  "command": {
    "argv": [
      "{python}",
      "-m",
      "scout_agent_builtin_tools",
      "map-raster-tiles",
      "--input",
      "{input}",
      "--json"
    ],
    "dry_run_argument": "--dry-run"
  },
  "mode": "workspace_write",
  "input_schema_ref": "schemas/scout_agent/map_raster_tiles.request.json",
  "output_schema_ref": "schemas/scout_agent/tool_result.json",
  "allowed_reads": [
    "local.raster_source_manifest",
    "local.geotiff.source_file"
  ],
  "allowed_writes": [
    "local.raster_tile_cache"
  ],
  "forbidden_writes": [
    "phase1.runtime",
    "phase2.brain.observed_facts",
    "live.safety_api",
    "repo.raw_raster_fixture",
    "repo.tile_fixture",
    "network.tile_download"
  ],
  "requires_authorization": {
    "kind": "user_or_operator"
  },
  "trace": {
    "required": true,
    "event_kind": "agent_tool_invocation"
  },
  "metadata": {
    "external_network_required": false,
    "repo_fixture_write_allowed": false,
    "raw_raster_committed_to_repo_allowed": false
  }
}
