{
  "id": "scout.map.tile_cache_plan",
  "version": "0.1.0",
  "description": "Build a read-only OSM/offline tile cache capacity plan and Scout hardware deployment manifest without downloading tiles.",
  "command": {
    "argv": [
      "{python}",
      "-m",
      "scout_agent_builtin_tools",
      "map-tile-cache-plan",
      "--input",
      "{input}",
      "--json"
    ],
    "dry_run_argument": null
  },
  "mode": "local_evidence_query",
  "input_schema_ref": "schemas/scout_agent/map_tile_cache_plan.request.json",
  "output_schema_ref": "schemas/scout_agent/tool_result.json",
  "allowed_reads": [
    "pretrip.workspace.project",
    "pretrip.route_summary",
    "local.tile_cache_capacity_policy"
  ],
  "allowed_writes": [],
  "forbidden_writes": [
    "phase1.runtime",
    "phase2.brain.observed_facts",
    "live.safety_api",
    "network.tile_download",
    "repo.tile_fixture",
    "local.tile_cache"
  ],
  "requires_authorization": {
    "kind": "none"
  },
  "trace": {
    "required": true,
    "event_kind": "agent_tool_invocation"
  },
  "metadata": {
    "read_only": true,
    "external_network_fetch_allowed": false,
    "bulk_download_started": false,
    "public_osm_bulk_download_allowed": false
  }
}
