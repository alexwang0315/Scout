{
  "id": "scout.ai.full_workflow.run",
  "version": "0.1.0",
  "description": "Run the read-only Scout AI question workflow from context discovery through deterministic evidence collection and answer synthesis, preserving sources, limitations, missing evidence, and safety boundary.",
  "command": {
    "argv": [
      "{python}",
      "-m",
      "scout_agent_builtin_tools",
      "ai-full-workflow",
      "--input",
      "{input}",
      "--json"
    ],
    "dry_run_argument": null
  },
  "mode": "local_evidence_query",
  "input_schema_ref": "schemas/scout_agent/ai_full_workflow.request.json",
  "output_schema_ref": "schemas/scout_agent/scout_ai_full_workflow.json",
  "allowed_reads": [
    "assistant.context_registry",
    "assistant.tool_registry",
    "assistant.tool_contracts",
    "assistant.tool_planner",
    "assistant.workflow_discovery",
    "assistant.evidence_collection",
    "assistant.answer_synthesis",
    "trip.local_evidence_index",
    "pretrip.workspace.project",
    "pretrip.workspace.candidates",
    "pretrip.workspace.outputs",
    "pretrip.workspace.reviews",
    "runtime.evidence_refs"
  ],
  "allowed_writes": [],
  "forbidden_writes": [
    "phase1.runtime",
    "phase2.brain.observed_facts",
    "live.safety_api",
    "transport.egress",
    "hardware.device",
    "pretrip.workspace"
  ],
  "requires_authorization": {
    "kind": "none"
  },
  "trace": {
    "required": true,
    "event_kind": "agent_tool_invocation"
  },
  "metadata": {
    "read_only": true,
    "runtime_safety_truth": false,
    "deterministic_evidence_required": true,
    "model_provider_used": false,
    "model_synthesis_performed": false,
    "runtime_activation_allowed": false,
    "outbound_send_allowed": false,
    "hardware_control_allowed": false,
    "raw_payloads_embedded": false,
    "model_output_is_runtime_truth": false
  }
}
