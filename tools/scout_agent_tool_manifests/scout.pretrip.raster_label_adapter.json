{
  "id": "scout.pretrip.raster_label_adapter",
  "version": "0.1.0",
  "description": "Normalize explicit OCR or map-label adapter output into candidate-only Scout raster label evidence.",
  "command": {
    "argv": [
      "{python}",
      "-m",
      "scout_agent_builtin_tools",
      "pretrip-raster-label-adapter",
      "--input",
      "{input}",
      "--json"
    ],
    "dry_run_argument": "--dry-run"
  },
  "mode": "workspace_write",
  "input_schema_ref": "schemas/scout_agent/pretrip_raster_label_adapter.request.json",
  "output_schema_ref": "schemas/scout_agent/tool_result.json",
  "allowed_reads": [
    "pretrip.workspace.project",
    "pretrip.workspace.outputs.layers.plans.raster_label_plan",
    "pretrip.workspace.outputs.layers.raw_raster_label_adapter_input",
    "operator.provided.ocr_json"
  ],
  "allowed_writes": [
    "pretrip.workspace.outputs.layers.normalized.raster_label_evidence",
    "pretrip.workspace.outputs.layers.raster_label_adapter_manifest",
    "pretrip.workspace.project_refs"
  ],
  "forbidden_writes": [
    "phase1.runtime",
    "phase2.brain.observed_facts",
    "live.safety_api"
  ],
  "requires_authorization": {
    "kind": "user_or_operator"
  },
  "trace": {
    "required": true,
    "event_kind": "agent_tool_invocation"
  },
  "metadata": {
    "standard_alignment": "SCOUT_OUTDOOR_AI_AGENT_STANDARD Sec. 6 Route Context Intelligence",
    "workspace_layout_section": "Outdoor AI Agent Data Placement",
    "network_policy": "no_live_network_fetch",
    "live_ocr_or_vision_performed": false,
    "explicit_adapter_input_required": true,
    "preferred_sources": ["rudy", "rudy_twmap"],
    "candidate_only": true,
    "runtime_safety_truth": false,
    "raw_payloads_embedded": false,
    "raw_tiles_embedded": false
  }
}
