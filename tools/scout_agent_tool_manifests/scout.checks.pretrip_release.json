{
  "id": "scout.checks.pretrip_release",
  "version": "0.1.0",
  "description": "Run the Phase 4 pretrip alpha release check as a read-only report for operator/agent inspection.",
  "command": {
    "argv": [
      "{python}",
      "-m",
      "scout_agent_builtin_tools",
      "checks-pretrip-release",
      "--input",
      "{input}",
      "--json"
    ],
    "dry_run_argument": null
  },
  "mode": "local_evidence_query",
  "input_schema_ref": "schemas/scout_agent/checks_pretrip_release.request.json",
  "output_schema_ref": "schemas/scout_agent/tool_result.json",
  "allowed_reads": [
    "repo.release_check.phase4_pretrip",
    "pretrip.workspace.project",
    "pretrip.fixture.chilai_nanhua_day1",
    "docs.specs.pretrip"
  ],
  "allowed_writes": [],
  "forbidden_writes": [
    "phase1.runtime",
    "phase2.brain.observed_facts",
    "live.safety_api",
    "pretrip.workspace",
    "runtime.export_bundle"
  ],
  "requires_authorization": {
    "kind": "none"
  },
  "trace": {
    "required": true,
    "event_kind": "agent_tool_invocation"
  },
  "metadata": {
    "read_only": true,
    "runtime_activation_allowed": false,
    "gate_failure_exit_code": 0
  }
}
