{
  "id": "scout.pretrip.route_context_collect",
  "version": "0.1.0",
  "description": "Collect post-import Route Context Intelligence evidence into the Scout pretrip workspace layout.",
  "command": {
    "argv": [
      "{python}",
      "-m",
      "scout_agent_builtin_tools",
      "pretrip-route-context-collect",
      "--input",
      "{input}",
      "--json"
    ],
    "dry_run_argument": "--dry-run"
  },
  "mode": "workspace_write",
  "input_schema_ref": "schemas/scout_agent/pretrip_route_context_collect.request.json",
  "output_schema_ref": "schemas/scout_agent/tool_result.json",
  "allowed_reads": [
    "pretrip.workspace.project",
    "pretrip.workspace.import_manifest",
    "pretrip.workspace.normalized.routes",
    "pretrip.workspace.outputs.mcp",
    "pretrip.workspace.outputs.layers.normalized.web_case_evidence",
    "pretrip.workspace.outputs.layers.normalized.raster_label_evidence",
    "pretrip.workspace.candidates.route_notes"
  ],
  "allowed_writes": [
    "pretrip.workspace.normalized.context.route_context",
    "pretrip.workspace.candidates.route_context"
  ],
  "forbidden_writes": [
    "phase1.runtime",
    "phase2.brain.observed_facts",
    "live.safety_api"
  ],
  "requires_authorization": {
    "kind": "user_or_operator"
  },
  "trace": {
    "required": true,
    "event_kind": "agent_tool_invocation"
  },
  "metadata": {
    "standard_alignment": "SCOUT_OUTDOOR_AI_AGENT_STANDARD Sec. 6 Route Context Intelligence",
    "workspace_layout_section": "Outdoor AI Agent Data Placement",
    "network_policy": "no_live_network_fetch",
    "candidate_only": true
  }
}
