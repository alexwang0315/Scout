{
  "id": "scout.imprint.export_pretrip",
  "version": "0.1.0",
  "description": "Export reviewed pretrip spatial imprints into an advisory imprint set and manifest without runtime activation.",
  "command": {
    "argv": [
      "{python}",
      "-m",
      "scout_agent_builtin_tools",
      "spatial-imprint-export-pretrip",
      "--input",
      "{input}",
      "--json"
    ],
    "dry_run_argument": "--dry-run"
  },
  "mode": "workspace_write",
  "input_schema_ref": "schemas/scout_agent/spatial_imprint_export_pretrip.request.json",
  "output_schema_ref": "schemas/scout_agent/tool_result.json",
  "allowed_reads": [
    "pretrip.workspace.project",
    "pretrip.spatial_imprint_candidates",
    "pretrip.spatial_imprint_reviews"
  ],
  "allowed_writes": [
    "pretrip.workspace.spatial_imprint_set",
    "pretrip.workspace.spatial_imprint_manifest"
  ],
  "forbidden_writes": [
    "phase1.runtime",
    "phase2.brain.observed_facts",
    "live.safety_api"
  ],
  "requires_authorization": {
    "kind": "user_or_operator"
  },
  "trace": {
    "required": true,
    "event_kind": "agent_tool_invocation"
  }
}
