{
  "id": "scout.pretrip.route_briefing_compose",
  "version": "0.1.0",
  "description": "Compose a candidate-only HTML route briefing from operator-reviewed pretrip route research.",
  "command": {
    "argv": [
      "{python}",
      "-m",
      "pretrip_route_briefing_compose",
      "--input",
      "{input}",
      "--output",
      "{output}",
      "--json"
    ],
    "dry_run_argument": "--dry-run"
  },
  "mode": "workspace_write",
  "input_schema_ref": "schemas/scout_agent/pretrip_route_briefing_compose.request.json",
  "output_schema_ref": "schemas/scout_agent/tool_result.json",
  "allowed_reads": [
    "pretrip.workspace.project",
    "pretrip.workspace.route_summary",
    "pretrip.workspace.route_research_pack",
    "pretrip.workspace.normalized.context.route_context",
    "pretrip.workspace.candidates.route_context"
  ],
  "allowed_writes": [
    "pretrip.workspace.outputs.briefings",
    "pretrip.workspace.candidates.route_briefings"
  ],
  "forbidden_writes": [
    "phase1.runtime",
    "phase1.safety",
    "phase2.brain.observed_facts",
    "live.safety_api",
    "hardware.controls"
  ],
  "requires_authorization": {
    "kind": "user_or_operator"
  },
  "trace": {
    "required": true,
    "event_kind": "agent_tool_invocation"
  },
  "metadata": {
    "standard_alignment": "SCOUT_OUTDOOR_AI_AGENT_STANDARD Sec. 6 Route Context Intelligence and pretrip briefing artifacts",
    "workspace_layout_section": "Pretrip outputs/briefings",
    "network_policy": "no_live_network_fetch",
    "source_policy": "operator_reviewed_sources_only",
    "candidate_only": true,
    "runtime_safety_truth": false,
    "briefing_html": true
  }
}
