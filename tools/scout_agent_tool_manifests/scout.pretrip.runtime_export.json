{
  "id": "scout.pretrip.runtime_export",
  "version": "0.1.0",
  "description": "Write an immutable runtime export bundle from a final MissionGraph and runtime handoff manifest without activating a live runtime session.",
  "command": {
    "argv": [
      "{python}",
      "-m",
      "scout_agent_builtin_tools",
      "pretrip-runtime-export",
      "--input",
      "{input}",
      "--json"
    ],
    "dry_run_argument": "--dry-run"
  },
  "mode": "package_write",
  "input_schema_ref": "schemas/scout_agent/pretrip_runtime_export.request.json",
  "output_schema_ref": "schemas/scout_agent/tool_result.json",
  "allowed_reads": [
    "pretrip.final_mission_graph",
    "pretrip.runtime_handoff_manifest",
    "pretrip.workspace.project"
  ],
  "allowed_writes": [
    "runtime.export_bundle"
  ],
  "forbidden_writes": [
    "phase1.runtime",
    "phase2.brain.observed_facts",
    "live.safety_api",
    "runtime.live_session"
  ],
  "requires_authorization": {
    "kind": "user_or_operator"
  },
  "trace": {
    "required": true,
    "event_kind": "agent_tool_invocation"
  },
  "metadata": {
    "runtime_activation_allowed": false,
    "phase1_live_session_mutation_allowed": false,
    "safety_api_calls_allowed": false
  }
}
