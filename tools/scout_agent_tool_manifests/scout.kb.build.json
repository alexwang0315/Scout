{
  "id": "scout.kb.build",
  "version": "0.1.0",
  "description": "Build and persist a local Scout evidence index from a pretrip project without embedding raw route payloads.",
  "command": {
    "argv": [
      "{python}",
      "-m",
      "scout_agent_builtin_tools",
      "kb-build",
      "--input",
      "{input}",
      "--output",
      "{output}",
      "--json"
    ],
    "dry_run_argument": "--dry-run"
  },
  "mode": "workspace_write",
  "input_schema_ref": "schemas/scout_agent/kb_build.request.json",
  "output_schema_ref": "schemas/scout_agent/tool_result.json",
  "allowed_reads": [
    "pretrip.workspace.project",
    "pretrip.workspace.candidates",
    "pretrip.workspace.outputs",
    "pretrip.workspace.reviews"
  ],
  "allowed_writes": [
    "local.evidence_index"
  ],
  "forbidden_writes": [
    "phase1.runtime",
    "phase2.brain.observed_facts",
    "live.safety_api",
    "pretrip.package",
    "hardware"
  ],
  "requires_authorization": {
    "kind": "user_or_operator"
  },
  "trace": {
    "required": true,
    "event_kind": "agent_tool_invocation"
  },
  "metadata": {
    "offline_only": true,
    "raw_payloads_embedded": false,
    "runtime_activation_allowed": false
  }
}
