{
  "id": "scout.pretrip.weather_decision_collect",
  "version": "0.1.0",
  "description": "Collect Weather-to-Decision candidate evidence into the Scout pretrip workspace layout.",
  "command": {
    "argv": [
      "{python}",
      "-m",
      "scout_agent_builtin_tools",
      "pretrip-weather-decision-collect",
      "--input",
      "{input}",
      "--json"
    ],
    "dry_run_argument": "--dry-run"
  },
  "mode": "workspace_write",
  "input_schema_ref": "schemas/scout_agent/pretrip_weather_decision_collect.request.json",
  "output_schema_ref": "schemas/scout_agent/tool_result.json",
  "allowed_reads": [
    "pretrip.workspace.project",
    "pretrip.workspace.weather_daylight_evidence",
    "pretrip.workspace.normalized.weather",
    "pretrip.workspace.normalized.routes",
    "pretrip.workspace.candidates.segments",
    "pretrip.workspace.outputs.compiled_mission_graph"
  ],
  "allowed_writes": [
    "pretrip.workspace.normalized.weather.weather_source_manifest",
    "pretrip.workspace.candidates.weather_decision_candidates",
    "pretrip.workspace.outputs.route_weather_package"
  ],
  "forbidden_writes": [
    "phase1.runtime",
    "phase2.brain.observed_facts",
    "live.safety_api"
  ],
  "requires_authorization": {
    "kind": "user_or_operator"
  },
  "trace": {
    "required": true,
    "event_kind": "agent_tool_invocation"
  },
  "metadata": {
    "standard_alignment": "SCOUT_OUTDOOR_AI_AGENT_STANDARD Sec. 10 Weather-to-Decision Intelligence",
    "workspace_layout_section": "Outdoor AI Agent Data Placement",
    "network_policy": "no_live_network_fetch",
    "candidate_only": true
  }
}
