{
  "id": "scout.safety_action.shelter_direction",
  "version": "0.1.0",
  "description": "Rank local candidate shelter/rest/retreat targets from pretrip evidence and return an advisory direction brief.",
  "command": {
    "argv": [
      "{python}",
      "-m",
      "scout_agent_builtin_tools",
      "safety-action-shelter-direction",
      "--input",
      "{input}",
      "--json"
    ],
    "dry_run_argument": null
  },
  "mode": "ephemeral_safety_action",
  "input_schema_ref": "schemas/scout_agent/safety_action_shelter_direction.request.json",
  "output_schema_ref": "schemas/scout_agent/tool_result.json",
  "allowed_reads": [
    "pretrip.workspace.map_candidates",
    "pretrip.workspace.retreat_routes",
    "pretrip.workspace.spatial_imprints",
    "pretrip.workspace.weather_daylight"
  ],
  "allowed_writes": [],
  "forbidden_writes": [
    "phase1.runtime",
    "phase2.brain.observed_facts",
    "live.safety_api"
  ],
  "requires_authorization": {
    "kind": "none"
  },
  "trace": {
    "required": true,
    "event_kind": "agent_tool_invocation"
  },
  "metadata": {
    "candidate_only": true,
    "local_evidence_only": true,
    "ttl_seconds_default": 600
  }
}
