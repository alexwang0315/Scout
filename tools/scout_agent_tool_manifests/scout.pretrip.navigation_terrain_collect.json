{
  "id": "scout.pretrip.navigation_terrain_collect",
  "version": "0.1.0",
  "description": "Collect Navigation & Terrain Intelligence readiness into the Scout pretrip workspace layout.",
  "command": {
    "argv": [
      "{python}",
      "-m",
      "scout_agent_builtin_tools",
      "pretrip-navigation-terrain-collect",
      "--input",
      "{input}",
      "--json"
    ],
    "dry_run_argument": "--dry-run"
  },
  "mode": "workspace_write",
  "input_schema_ref": "schemas/scout_agent/pretrip_navigation_terrain_collect.request.json",
  "output_schema_ref": "schemas/scout_agent/tool_result.json",
  "allowed_reads": [
    "pretrip.workspace.project",
    "pretrip.workspace.normalized.map.map_context",
    "pretrip.workspace.normalized.terrain",
    "pretrip.workspace.outputs.risk",
    "pretrip.workspace.reference_tracks",
    "pretrip.workspace.candidates.retreat_routes",
    "pretrip.workspace.checkpoint_candidates",
    "pretrip.workspace.segment_candidates"
  ],
  "allowed_writes": [
    "pretrip.workspace.normalized.navigation.offline_map_manifest",
    "pretrip.workspace.normalized.navigation.ins_dr_readiness"
  ],
  "forbidden_writes": [
    "phase1.runtime",
    "phase2.brain.observed_facts",
    "live.safety_api",
    "hardware"
  ],
  "requires_authorization": {
    "kind": "user_or_operator"
  },
  "trace": {
    "required": true,
    "event_kind": "agent_tool_invocation"
  },
  "metadata": {
    "standard_alignment": "SCOUT_OUTDOOR_AI_AGENT_STANDARD Sec. 11 Navigation & Terrain Intelligence",
    "workspace_layout_section": "Outdoor AI Agent Data Placement",
    "network_policy": "no_live_network_fetch",
    "candidate_only": true,
    "runtime_safety_truth": false,
    "live_sensor_read_allowed": false,
    "hardware_control_allowed": false
  }
}
