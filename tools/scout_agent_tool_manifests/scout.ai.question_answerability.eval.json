{
  "id": "scout.ai.question_answerability.eval",
  "version": "0.1.0",
  "description": "Evaluate whether Scout AI can answer a question corpus with current read-only tools, recommended future tools, or missing evidence reasons.",
  "command": {
    "argv": [
      "{python}",
      "-m",
      "scout_agent_builtin_tools",
      "ai-question-answerability",
      "--input",
      "{input}",
      "--json"
    ],
    "dry_run_argument": null
  },
  "mode": "local_evidence_query",
  "input_schema_ref": "schemas/scout_agent/ai_question_answerability.request.json",
  "output_schema_ref": "schemas/scout_agent/tool_result.json",
  "allowed_reads": [
    "assistant.question_corpus",
    "assistant.tool_registry",
    "pretrip.workspace.project",
    "runtime.evidence_refs"
  ],
  "allowed_writes": [],
  "forbidden_writes": [
    "phase1.runtime",
    "phase2.brain.observed_facts",
    "live.safety_api",
    "transport.egress",
    "hardware.device"
  ],
  "requires_authorization": {
    "kind": "none"
  },
  "trace": {
    "required": true,
    "event_kind": "agent_tool_invocation"
  },
  "metadata": {
    "read_only": true,
    "runtime_safety_truth": false,
    "runtime_activation_allowed": false,
    "outbound_send_allowed": false,
    "medical_diagnosis": false
  }
}
