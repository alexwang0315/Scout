{
  "id": "scout.ai.context_registry.describe",
  "version": "0.1.0",
  "description": "Describe Scout AI pretrip context sources, source discovery status, mapped tool ids, missing evidence, and read-only safety boundaries.",
  "command": {
    "argv": [
      "{python}",
      "-m",
      "scout_agent_builtin_tools",
      "ai-context-registry",
      "--input",
      "{input}",
      "--json"
    ],
    "dry_run_argument": null
  },
  "mode": "local_evidence_query",
  "input_schema_ref": "schemas/scout_agent/ai_context_registry.request.json",
  "output_schema_ref": "schemas/scout_agent/scout_ai_context_registry.json",
  "allowed_reads": [
    "assistant.context_registry",
    "assistant.tool_registry",
    "assistant.tool_contracts",
    "pretrip.workspace.project",
    "pretrip.workspace.candidates",
    "pretrip.workspace.outputs",
    "pretrip.workspace.reviews"
  ],
  "allowed_writes": [],
  "forbidden_writes": [
    "phase1.runtime",
    "phase2.brain.observed_facts",
    "live.safety_api",
    "transport.egress",
    "hardware.device",
    "pretrip.workspace"
  ],
  "requires_authorization": {
    "kind": "none"
  },
  "trace": {
    "required": true,
    "event_kind": "agent_tool_invocation"
  },
  "metadata": {
    "read_only": true,
    "runtime_safety_truth": false,
    "runtime_activation_allowed": false,
    "outbound_send_allowed": false,
    "hardware_control_allowed": false,
    "raw_payloads_embedded": false,
    "model_output_is_runtime_truth": false
  }
}
