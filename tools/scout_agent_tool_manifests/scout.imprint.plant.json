{
  "id": "scout.imprint.plant",
  "version": "0.1.0",
  "description": "Plant an operator/user-authorized runtime spatial imprint into the local advisory imprint store.",
  "command": {
    "argv": [
      "{python}",
      "-m",
      "scout_agent_builtin_tools",
      "spatial-imprint-plant",
      "--input",
      "{input}",
      "--json"
    ],
    "dry_run_argument": "--dry-run"
  },
  "mode": "workspace_write",
  "input_schema_ref": "schemas/scout_agent/spatial_imprint_plant.request.json",
  "output_schema_ref": "schemas/scout_agent/tool_result.json",
  "allowed_reads": [
    "runtime.spatial_imprint_store",
    "runtime.operator_intent"
  ],
  "allowed_writes": [
    "runtime.spatial_imprint_store",
    "runtime.spatial_imprint_audit_log"
  ],
  "forbidden_writes": [
    "phase1.runtime",
    "phase2.brain.observed_facts",
    "live.safety_api"
  ],
  "requires_authorization": {
    "kind": "user_or_operator"
  },
  "trace": {
    "required": true,
    "event_kind": "agent_tool_invocation"
  }
}
