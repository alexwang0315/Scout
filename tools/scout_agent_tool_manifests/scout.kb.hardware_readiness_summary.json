{
  "id": "scout.kb.hardware_readiness_summary",
  "version": "0.1.0",
  "description": "Summarize the fixture-backed hardware readiness view for Scout Agent without hardware/provider control.",
  "command": {
    "argv": [
      "{python}",
      "-m",
      "scout_agent_builtin_tools",
      "kb-hardware-readiness-summary",
      "--input",
      "{input}",
      "--json"
    ],
    "dry_run_argument": null
  },
  "mode": "local_evidence_query",
  "input_schema_ref": "schemas/scout_agent/hardware_readiness_summary.request.json",
  "output_schema_ref": "schemas/scout_agent/tool_result.json",
  "allowed_reads": [
    "hardware.readiness_fixture",
    "hardware.interface_inventory",
    "hardware.provider_health",
    "runtime.debug_trace",
    "mock.outbound_queue"
  ],
  "allowed_writes": [],
  "forbidden_writes": [
    "phase1.runtime",
    "phase2.brain.observed_facts",
    "live.safety_api",
    "hardware.provider_control",
    "hardware.gpio_drive",
    "real.sos",
    "real.sms",
    "real.satellite",
    "real.network_send"
  ],
  "requires_authorization": {
    "kind": "none"
  },
  "trace": {
    "required": true,
    "event_kind": "agent_tool_invocation"
  },
  "metadata": {
    "read_only": true,
    "hardware_control_allowed": false,
    "gpio_drive_implementation_enabled": false,
    "provider_control_allowed": false
  }
}
