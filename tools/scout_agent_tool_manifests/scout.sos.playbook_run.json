{
  "id": "scout.sos.playbook_run",
  "version": "0.1.0",
  "description": "Run a deterministic mock-only SOS delegated emergency playbook after explicit SOS activation.",
  "command": {
    "argv": [
      "{python}",
      "-m",
      "scout_agent_builtin_tools",
      "sos-playbook-run",
      "--input",
      "{input}",
      "--json"
    ],
    "dry_run_argument": "--dry-run"
  },
  "mode": "sos_delegated_emergency",
  "input_schema_ref": "schemas/scout_agent/sos_playbook_run.request.json",
  "output_schema_ref": "schemas/scout_agent/tool_result.json",
  "allowed_reads": [
    "sos.activation_event",
    "pretrip.reviewed_trip_refs",
    "runtime.latest_position"
  ],
  "allowed_writes": [
    "runtime.debug_trace.sos_playbook",
    "mock.outbound_queue",
    "mock.voice_queue"
  ],
  "forbidden_writes": [
    "phase1.runtime",
    "phase2.brain.observed_facts",
    "live.safety_api",
    "real.sos",
    "real.sms",
    "real.satellite",
    "hardware.alarm"
  ],
  "requires_authorization": {
    "kind": "sos_delegated"
  },
  "trace": {
    "required": true,
    "event_kind": "agent_tool_invocation"
  },
  "metadata": {
    "mock_outbound_only": true,
    "real_sos_sent": false,
    "hardware_control_allowed": false
  }
}
