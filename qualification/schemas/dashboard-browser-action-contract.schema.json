{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scout.dashboardBrowserActionContract.v1",
  "type": "object",
  "required": [
    "schema",
    "version",
    "official_mode",
    "profiles",
    "routes",
    "map_surfaces",
    "required_map_gestures",
    "required_map_content",
    "control_coverage",
    "visual_quality"
  ],
  "properties": {
    "schema": {"const": "scout.dashboardBrowserActionContract.v1"},
    "version": {"type": "integer", "minimum": 1},
    "official_mode": {
      "type": "object",
      "required": [
        "runtime_provenance",
        "pre_existing_runtime_required",
        "browser_operation_required",
        "contract_tests_are_dashboard_evidence",
        "zero_unmapped_controls_required",
        "zero_unreviewed_visual_states_required"
      ],
      "properties": {
        "runtime_provenance": {"const": "live_operational_dashboard"},
        "pre_existing_runtime_required": {"const": true},
        "browser_operation_required": {"const": true},
        "contract_tests_are_dashboard_evidence": {"const": false},
        "zero_unmapped_controls_required": {"const": true},
        "zero_unreviewed_visual_states_required": {"const": true}
      },
      "additionalProperties": false
    },
    "profiles": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "width", "height"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "width": {"type": "integer", "minimum": 320},
          "height": {"type": "integer", "minimum": 480}
        },
        "additionalProperties": false
      }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "require_control_census", "require_visual_audit"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "require_control_census": {"const": true},
          "require_visual_audit": {"const": true}
        },
        "additionalProperties": false
      }
    },
    "map_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "route", "kind"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "route": {"type": "string", "minLength": 1},
          "kind": {"enum": ["native", "embedded-pretrip"]},
          "viewport_id": {"type": "string", "minLength": 1},
          "frame_selector": {"type": "string", "minLength": 1},
          "layer_scope": {"enum": ["pretrip", "weather"]}
        },
        "allOf": [
          {
            "if": {"properties": {"kind": {"const": "native"}}},
            "then": {"required": ["viewport_id"]}
          },
          {
            "if": {"properties": {"kind": {"const": "embedded-pretrip"}}},
            "then": {"required": ["frame_selector", "layer_scope"]}
          }
        ],
        "additionalProperties": false
      }
    },
    "required_map_gestures": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {"enum": ["fit", "zoom_in", "zoom_out", "mouse_pan", "keyboard_pan", "rectangle_zoom"]}
    },
    "required_map_content": {"type": "object"},
    "control_coverage": {
      "type": "object",
      "required": [
        "interactive_selector",
        "include_embedded_frames",
        "disabled_controls_require_executable_state",
        "delegated_controls_require_passing_specialist_case",
        "allowed_terminal_states",
        "blocking_terminal_states",
        "mutation_actions_require_explicit_authorization",
        "browser_local_state_is_not_server_persistence_evidence"
      ],
      "properties": {
        "interactive_selector": {"type": "string", "minLength": 1},
        "include_embedded_frames": {"const": true},
        "disabled_controls_require_executable_state": {"const": true},
        "delegated_controls_require_passing_specialist_case": {"const": true},
        "allowed_terminal_states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["OPERATED", "DELEGATED", "GUARD_VERIFIED"]}
        },
        "blocking_terminal_states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "contains": {"const": "NOT_EXERCISED"},
          "items": {
            "enum": [
              "UNMAPPED",
              "MISSING_AFTER_RELOAD",
              "DISABLED_IN_RUNTIME_STATE",
              "DISAPPEARED_BEFORE_OPERATION",
              "NONVISIBLE_AFTER_DISCOVERY",
              "SINGLE_RUNTIME_VALUE",
              "ROUTE_ABORTED_AFTER_OPERATION_ERROR",
              "NOT_EXERCISED",
              "NO_STATE_CHANGE",
              "NO_VISUAL_CHANGE",
              "EFFECT_AUTHORIZATION_REQUIRED"
            ]
          }
        },
        "mutation_actions_require_explicit_authorization": {"const": true},
        "browser_local_state_is_not_server_persistence_evidence": {"const": true}
      },
      "additionalProperties": false
    },
    "visual_quality": {"type": "object"}
  },
  "additionalProperties": false
}
