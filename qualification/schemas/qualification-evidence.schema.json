{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scout.dashboardQualificationEvidence.v1",
  "type": "object",
  "required": [
    "schema",
    "commit_sha",
    "manifest_sha256",
    "runtime_attestation_sha256",
    "runtime_provenance",
    "runtime_continuity_verified",
    "runner_started_runtime",
    "evidence_root_sha256",
    "machine_verdict"
  ],
  "properties": {
    "schema": {"const": "scout.dashboardQualificationEvidence.v1"},
    "commit_sha": {"type": "string", "minLength": 7},
    "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "runtime_attestation_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "runtime_provenance": {"const": "live_operational_dashboard"},
    "runtime_continuity_verified": {"const": true},
    "runner_started_runtime": {"const": false},
    "evidence_root_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "machine_verdict": {"enum": ["PASS", "FAIL", "FLAKY", "BLOCKED", "NOT_IMPLEMENTED", "INSUFFICIENT_EVIDENCE"]},
    "merge_permitted": {"type": "boolean"}
  },
  "additionalProperties": true
}
