    {"id": "P3D-05", "requirement": "Contextual Permission is an exact retained Phase 2 prerequisite and cannot be weakened by the aggregate adapter."},
    {"id": "P3D-06", "requirement": "Safety privacy candidate-only explicit-confirmation deterministic-admission and no-outbound/no-hardware boundaries are executable invariants with before-invocation effect evidence."},
    {"id": "P3D-07", "requirement": "Durable-operation-by-fault-phase and conflict-pair-by-shared-yield matrices are derived per domain use fresh identities and fail closed on every uncovered or unactivated cell."},
    {"id": "P3D-08", "requirement": "Domain and cross-domain mutants have isolated activation and exact attribution including surface dependency identity publication privacy effect and aggregate false-pass mutants."},
    {"id": "P3D-09", "requirement": "Explicit active-workspace inventory is read-only metadata-whitelisted path-confined privacy-bounded and reconciles every persisted capability to support migration or quarantine."},
    {"id": "P3D-10", "requirement": "All and release modes have distinct claims; aggregate canonical identity atomic output projection parity and total exit semantics prevent omitted-domain or incomplete-evidence passes."},
    {"id": "P3D-11", "requirement": "Closure evidence includes focused domain and cross-domain tests retained Phase 1 and 2 regressions source-manifest recomputation and exact per-domain and aggregate case reconciliation."},
    {"id": "P3D-12", "requirement": "Phase 3 remains internal pre-release qualification separate from runtime Diagnostic UI and makes no unearned production real-workspace runtime-safety outbound or hardware claim."}
